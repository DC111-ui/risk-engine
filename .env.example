# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Set by CloudFormation automatically. Override only for local development.
DYNAMODB_TABLE_NAME=fraud-risk-engine-transactions-prod

# ── API ───────────────────────────────────────────────────────────────────────
STAGE=prod

# Change to your portfolio domain once frontend is live
CORS_ALLOW_ORIGIN=https://darlingtonchanakira.com
